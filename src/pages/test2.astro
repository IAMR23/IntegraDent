---
import Footer from "../components/Footer.astro";
import Gallery1 from "../components/Gallery1.astro";
import ListaServices1 from "../components/ListaServices1.astro";
import NavBar from "../components/NavBar.astro";
import Whatsapp from "../components/Whatsapp.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout title="Carillas">
  <NavBar />

  <div class="p-14 bg-black"></div>

  <div class="w-full py-16 px-4">
    <div class="flex flex-col md:flex-row items-center gap-4">
      <div class="flex-1">
        <div class="space-x-4">
          <button
            class="px-4 py-2 bg-blue-500 text-white rounded"
            onclick="openModal('modal1')">Abrir Modal 1</button
          >
          <button
            class="px-4 py-2 bg-green-500 text-white rounded"
            onclick="openModal('modal2')">Abrir Modal 2</button
          >
          <button
            class="px-4 py-2 bg-red-500 text-white rounded"
            onclick="openModal('modal3')">Abrir Modal 3</button
          >
        </div>

        <!-- Modales -->
        <div
          id="modal1"
          class="fixed inset-0 flex items-center justify-center bg-black bg-opacity-50"
        >
          <div class="bg-white p-6 rounded-lg shadow-lg w-96 text-center">
            <p class="mb-4">Este es el Modal 1</p>
            <button
              class="px-4 py-2 bg-gray-500 text-white rounded"
              onclick="closeModal('modal1')">Cerrar</button
            >
          </div>
        </div>

        <div
          id="modal2"
          class="fixed inset-0 flex items-center justify-center bg-black bg-opacity-50"
        >
          <div class="bg-white p-6 rounded-lg shadow-lg w-96 text-center">
            <p class="mb-4">Este es el Modal 2</p>
            <button
              class="px-4 py-2 bg-gray-500 text-white rounded"
              onclick="closeModal('modal2')">Cerrar</button
            >
          </div>
        </div>

        <div
          id="modal3"
          class="fixed inset-0 flex items-center justify-center bg-black bg-opacity-50"
        >
          <div class="bg-white p-6 rounded-lg shadow-lg w-96 text-center">
            <p class="mb-4">Este es el Modal 3</p>
            <button
              class="px-4 py-2 bg-gray-500 text-white rounded"
              onclick="closeModal('modal3')">Cerrar</button
            >
          </div>
        </div>
      </div>

      <div
        class="flex-1 flex flex-col items-center md:items-start text-center md:text-left gap-2"
      >
        <h2 class="text-3xl md:text-4xl font-bold">🦷CARILLAS😁</h2>

        <span>#SonrisasRealesIntegradent</span>
        <p class="text-gray-600 leading-relaxed text-justify">
          El bruxismo es un trastorno en el que rechinas, crujes o aprietas los
          dientes. Si tienes bruxismo, es posible que, de manera inconsciente,
          aprietes los dientes cuando estás despierto (bruxismo diurno) o que
          los aprietes o rechines mientras duermes (bruxismo nocturno).
        </p>

        <span
          >No arriesgues tu salud en manos de cualquiera... ¡Nosotros somos los
          indicados!</span
        >
      </div>
    </div>
    <ListaServices1 />
  </div>

  <Whatsapp />
  <Footer />
</Layout>
