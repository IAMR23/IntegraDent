---
import Footer from "../components/Footer.astro";
import Gallery1 from "../components/Gallery1.astro";
import ListaServices from "../components/ListaServices.astro";
import NavBar from "../components/NavBar.astro";
import Whatsapp from "../components/Whatsapp.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout title="Carillas">
  <NavBar />

  <div class="p-14 bg-black"></div>

  <div class="w-full py-16 px-4">
    <div class="flex flex-col md:flex-row items-center gap-4">
      <div
        class="flex justify-center flex-col items-center gap-2 flex-1 min-w-f"
      >
        <button
          id="button1"
          class="bg-black hover:bg-gray-700 text-white font-bold py-2 px-4 rounded w-1/2"
        >
          Caso 1
        </button>

        <button
          id="button2"
          class="bg-black hover:bg-gray-700 text-white font-bold py-2 px-4 rounded w-1/2"
        >
          Caso 2
        </button>

        <button
          id="button3"
          class="bg-black hover:bg-gray-700 text-white font-bold py-2 px-4 rounded w-1/2"
        >
          Caso 3
        </button>
      </div>

      <div
        class="flex-1 flex flex-col items-center md:items-start text-center md:text-left gap-2"
      >
        <h2 class="text-3xl md:text-4xl font-bold">CARILLAS</h2>

        <span>#SonrisasRealesIntegradent</span>
        <p class="text-gray-600 leading-relaxed text-justify">
          El bruxismo es un trastorno en el que rechinas, crujes o aprietas los
          dientes. Si tienes bruxismo, es posible que, de manera inconsciente,
          aprietes los dientes cuando estás despierto (bruxismo diurno) o que
          los aprietes o rechines mientras duermes (bruxismo nocturno).
        </p>

        <span
          >No arriesgues tu salud en manos de cualquiera... ¡Nosotros somos los
          indicados!</span
        >
      </div>
      <div class="flex">
        <ListaServices />
      </div>
    </div>
  </div>

  <div class="flex space-x-4 p-6 flex-col"></div>

  <!-- Modal 1 -->
  <div
    id="modal1"
    class="fixed inset-0 bg-gray-600 bg-opacity-50 flex items-center justify-center"
  >
    <div class="bg-white p-8 rounded-lg shadow-xl max-w-md w-full">
      <div class="flex justify-between items-start mb-4">
        <h3 class="text-xl font-bold">Mensaje del Modal 1</h3>
        <button class="modal-close text-gray-500 hover:text-gray-700">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
            <path
              fill-rule="evenodd"
              d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z"
              clip-rule="evenodd"></path>
          </svg>
        </button>
      </div>
      <p>
        Este es el contenido del primer modal. Puedes cerrar este modal haciendo
        clic en la X o haciendo clic fuera de él.
      </p>
    </div>
  </div>

  <!-- Modal 2 -->
  <div
    id="modal2"
    class="fixed inset-0 bg-gray-600 bg-opacity-50 flex items-center justify-center"
  >
    <div class="bg-white p-8 rounded-lg shadow-xl max-w-md w-full">
      <div class="flex justify-between items-start mb-4">
        <h3 class="text-xl font-bold">Mensaje del Modal 2</h3>
        <button class="modal-close text-gray-500 hover:text-gray-700">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
            <path
              fill-rule="evenodd"
              d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z"
              clip-rule="evenodd"></path>
          </svg>
        </button>
      </div>
      <p>
        Este es el contenido del segundo modal. La información que se muestra
        aquí puede ser personalizada según tus necesidades.
      </p>
    </div>
  </div>

  <!-- Modal 3 -->
  <div
    id="modal3"
    class="fixed inset-0 bg-gray-600 bg-opacity-50 flex items-center justify-center"
  >
    <div class="bg-white p-8 rounded-lg shadow-xl">
      <div class="flex justify-between items-start">
        <h3 class="text-xl font-bold text-center">Caso 3</h3>
        <button class="modal-close text-gray-500 hover:text-gray-700">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
            <path
              fill-rule="evenodd"
              d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z"
              clip-rule="evenodd"></path>
          </svg>
        </button>
      </div>
      <p>
        <Gallery1 />
      </p>
    </div>
  </div>

  <script>
    // Función para abrir un modal específico
    function openModal(modalId: any) {
      const modal = document.getElementById(modalId);
      if (modal) {
        modal.classList.remove("hidden");
      }
    }

    // Función para cerrar todos los modales
    function closeAllModals() {
      const modals = document.querySelectorAll('[id^="modal"]');
      modals.forEach((modal) => {
        modal.classList.add("hidden");
      });
    }

    // Configurar botones para abrir modales
    document
      .getElementById("button1")
      ?.addEventListener("click", () => openModal("modal1"));
    document
      .getElementById("button2")
      ?.addEventListener("click", () => openModal("modal2"));
    document
      .getElementById("button3")
      ?.addEventListener("click", () => openModal("modal3"));

    // Cerrar modal al hacer clic en X
    const closeButtons = document.querySelectorAll(".modal-close");
    closeButtons.forEach((button) => {
      button.addEventListener("click", closeAllModals);
    });

    // Cerrar modal al hacer clic fuera del contenido
    const modals = document.querySelectorAll('[id^="modal"]');
    modals.forEach((modal) => {
      modal.addEventListener("click", (event) => {
        if (event.target === modal) {
          closeAllModals();
        }
      });
    });
  </script>

  <Whatsapp />
  <Footer />
</Layout>
